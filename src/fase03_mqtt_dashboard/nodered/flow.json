  {
    "id": "ch_alerta",
    "type": "change",
    "z": "tab_cardioai_f3",
    "name": "extract alertaTexto + cor",
    "rules": [
      {
        "t": "set",
        "p": "color",
        "pt": "msg",
        "to": "$boolean(payload.alerta) ? '#c62828' : '#2e7d32'",
        "tot": "jsonata"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "payload.alertaTexto",
        "tot": "msg"
      }
    ],
