[
  {
    "id": "tab_cardioai_f3",
    "type": "tab",
    "label": "CardioAI Fase 3",
    "disabled": false,
    "info": "Dashboard 2.0 + MQTT — Parte 2 da Fase 3 do CardioIA.\n\nFluxo:\n  mqtt in → validar payload → computar alerta →\n    ├─ split-series (topic=temp / topic=bpm) → ui-chart\n    ├─ extract umid → ui-gauge\n    └─ extract alertaTexto → ui-text\n\nBroker: broker.hivemq.com:1883 (público, sem TLS).\nTópico: cardioai/+/telemetry (wildcard de deviceId).\nDashboard: http://localhost:1880/dashboard"
  },
  {
    "id": "mqtt_in_telemetry",
    "type": "mqtt in",
    "z": "tab_cardioai_f3",
    "name": "telemetry",
    "topic": "cardioai/+/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker_hivemq",
    "nl": false,
    "rap": false,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 140,
    "wires": [
      [
        "fn_validar"
      ]
    ]
  },
  {
    "id": "fn_validar",
    "type": "function",
    "z": "tab_cardioai_f3",
    "name": "validar payload",
    "func": "if (typeof msg.payload !== 'object' || msg.payload === null) {\n    node.warn('payload inválido (não-objeto)');\n    return null;\n}\nconst p = msg.payload;\nif (typeof p.temp !== 'number' || typeof p.umid !== 'number' || typeof p.bpm !== 'number') {\n    node.warn('payload inválido (campos ausentes ou tipos errados)');\n    return null;\n}\nreturn msg;\n",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 320,
    "y": 140,
    "wires": [
      [
        "fn_alerta"
      ]
    ]
  },
  {
    "id": "fn_alerta",
    "type": "function",
    "z": "tab_cardioai_f3",
    "name": "computar alerta",
    "func": "const p = msg.payload;\nconst alerta = (p.bpm > 120) || (p.temp > 38);\np.alerta = alerta;\np.alertaTexto = alerta ? '⚠️ LIMITE ULTRAPASSADO' : '✓ NORMAL';\nreturn msg;\n",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 140,
    "wires": [
      [
        "fn_split",
        "ch_umid",
        "ch_alerta"
      ]
    ]
  },
  {
    "id": "fn_split",
    "type": "function",
    "z": "tab_cardioai_f3",
    "name": "split-series (temp + bpm)",
    "func": "const msgTemp = { topic: 'temp', payload: msg.payload.temp };\nconst msgBpm  = { topic: 'bpm',  payload: msg.payload.bpm };\nreturn [[msgTemp, msgBpm]];\n",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 80,
    "wires": [
      [
        "ui_chart_vitals"
      ]
    ]
  },
  {
    "id": "ui_chart_vitals",
    "type": "ui-chart",
    "z": "tab_cardioai_f3",
    "group": "ui_group_sinais",
    "name": "Sinais vitais",
    "label": "Temperatura (°C) e BPM",
    "order": 1,
    "chartType": "line",
    "category": "topic",
    "categoryType": "msg",
    "xAxisLabel": "",
    "xAxisProperty": "",
    "xAxisPropertyType": "msg",
    "xAxisType": "time",
    "xAxisFormat": "auto",
    "xAxisFormatType": "auto",
    "yAxisLabel": "",
    "yAxisProperty": "payload",
    "yAxisPropertyType": "msg",
    "stackSeries": false,
    "showLegend": true,
    "removeOlder": 5,
    "removeOlderUnit": 60,
    "removeOlderPoints": "",
    "width": 6,
    "height": 4,
    "className": "",
    "x": 1000,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
