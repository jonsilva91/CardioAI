# ===============================================================
# CardioAI - Fase 05: Assistente Conversacional
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# ===============================================================
# Copie este arquivo para .env e preencha com as suas credenciais.
# cp .env.example .env

# ---------------------------------------------------------------
# 1. Credenciais do IBM watsonx Assistant
# ---------------------------------------------------------------
# Chave de API IAM da IBM Cloud para autenticação
WATSONX_ASSISTANT_APIKEY=sua_api_key_ibm_aqui

# URL do endpoint de serviço da sua instância do Watson Assistant
WATSONX_ASSISTANT_URL=https://api.us-south.assistant.watson.cloud.ibm.com/instances/sua_instancia_aqui

# ID do Assistente (Assistant ID / Environment ID no IBM watsonx Assistant)
WATSONX_ASSISTANT_ID=seu_assistant_id_aqui

# Versão da API do Watson Assistant (padrão: 2023-06-15)
WATSONX_ASSISTANT_VERSION=2023-06-15

# ---------------------------------------------------------------
# 2. Configurações do Servidor Backend (Flask)
# ---------------------------------------------------------------
# Porta na qual o servidor HTTP do Flask será executado
PORT=5001

# Endereço de host para binding (0.0.0.0 aceita conexões externas e locais)
HOST=0.0.0.0

# Modo de depuração do Flask (True para desenvolvimento, False para produção)
FLASK_DEBUG=True

# Origens permitidas para CORS (ex.: * ou http://localhost:5173)
CORS_ORIGINS=*

# ---------------------------------------------------------------
# 3. Gerenciamento de Sessão Individual e Cache
# ---------------------------------------------------------------
SESSION_TTL_SECONDS=1800

# ---------------------------------------------------------------
# 4. Chaves de API de IA Generativa (Desafio Ir Além 1)
# ---------------------------------------------------------------
# Chave da OpenAI para geração diagnóstica humanizada ('gpt-4o-mini') e extração estruturada
OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui

# (Opcional) Chave da Google Gemini API caso opte pelo provedor Gemini
GEMINI_API_KEY=sua_chave_gemini_aqui

# ---------------------------------------------------------------
# 5. Banco de Dados NoSQL (MongoDB - Desafio Ir Além 2)
# ---------------------------------------------------------------
# URI de conexão com o MongoDB (Local ou MongoDB Atlas Cloud)
# Exemplo Local: mongodb://localhost:27017
# Exemplo Atlas: mongodb+srv://<usuario>:<senha>@cluster0.cardioai.mongodb.net/?retryWrites=true&w=majority&appName=CardioAI
MONGO_URI=mongodb://localhost:27017

# Nome do Banco de Dados NoSQL
MONGO_DATABASE=cardioai_nosql

# Timeout de seleção do servidor em milissegundos (resiliente para offline)
MONGO_TIMEOUT_MS=3000

