{
  "version": 1,
  "author": "CardioIA Fase 7",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "env": "micropython-20231227-v1.22.0" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -180,
      "left": -170,
      "attrs": { "temperature": "36.6", "humidity": "50" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": -180,
      "left": 180,
      "attrs": { "value": "1200", "label": "BPM (40-180)" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot2",
      "top": -40,
      "left": 180,
      "attrs": { "value": "3500", "label": "SpO2 (80-100%)" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 190,
      "left": -170,
      "attrs": { "color": "blue", "label": "Enviar Agora" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_green",
      "top": 160,
      "left": 150,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": 150,
      "left": 250,
      "attrs": { "color": "green", "label": "BAIXO" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_red",
      "top": 220,
      "left": 150,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": 210,
      "left": 250,
      "attrs": { "color": "red", "label": "ALTO/ALERTA" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -20,
      "left": -220,
      "attrs": { "i2cAddress": "0x3c" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "dht1:VCC", "red", [] ],
    [ "esp:GND.1", "dht1:GND", "black", [] ],
    [ "esp:4", "dht1:SDA", "green", [] ],

    [ "esp:3V3", "pot1:VCC", "red", [] ],
    [ "esp:GND.2", "pot1:GND", "black", [] ],
    [ "esp:34", "pot1:SIG", "yellow", [] ],

    [ "esp:3V3", "pot2:VCC", "red", [] ],
    [ "esp:GND.2", "pot2:GND", "black", [] ],
    [ "esp:35", "pot2:SIG", "orange", [] ],

    [ "esp:15", "btn1:1.l", "blue", [] ],
    [ "esp:GND.1", "btn1:2.l", "black", [] ],

    [ "esp:2", "r_green:1", "green", [] ],
    [ "r_green:2", "led_green:A", "green", [] ],
    [ "esp:GND.2", "led_green:C", "black", [] ],

    [ "esp:5", "r_red:1", "red", [] ],
    [ "r_red:2", "led_red:A", "red", [] ],
    [ "esp:GND.2", "led_red:C", "black", [] ],

    [ "esp:3V3", "oled1:VCC", "red", [] ],
    [ "esp:GND.1", "oled1:GND", "black", [] ],
    [ "esp:22", "oled1:SCL", "purple", [] ],
    [ "esp:21", "oled1:SDA", "cyan", [] ]
  ],
  "dependencies": {}
}

